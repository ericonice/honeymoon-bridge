{
  "name": "@hb/web",
  "version": "0.0.0",
  "private": true,
  "description": "Honeymoon Bridge PWA: the browser game against a computer opponent.",
  "type": "module",
  "scripts": {
    "bench:auction": "vite-node bench/auction.ts",
    "bench:bidcost": "vite-node bench/bidcost.ts",
    "bench:calibrate": "vite-node bench/calibrate.ts",
    "bench:draw": "vite-node bench/draw.ts",
    "bench:equity": "vite-node bench/equity.ts",
    "bench:head": "vite-node bench/head.ts",
    "bench:par": "vite-node bench/par.ts",
    "bench:rubber": "vite-node bench/rubber.ts",
    "bench:search": "vite-node bench/search.ts",
    "bench:strain": "vite-node bench/strain.ts",
    "build": "vite build",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=honeymoon-bridge",
    "dev": "vite",
    "dev:lan": "vite --host",
    "preview": "vite preview",
    "sync:ios": "vite build && cap sync ios",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@hb/engine": "*",
    "@hb/protocol": "*",
    "framer-motion": "^13.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5",
    "wrangler": "^4.120.0"
  }
}
